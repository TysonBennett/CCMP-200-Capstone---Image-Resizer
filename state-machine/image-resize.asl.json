{
  "Comment": "Image resizing workflow",
  "QueryLanguage": "JSONata",
  "StartAt": "ResizeImage",
  "States": {
    "ResizeImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:us-east-1:[ACCOUNT_ID]:function:image-resizer",
        "Payload": {
          "bucket": "{% $states.input.bucket %}",
          "key": "{% $states.input.key %}"
        }
      },
      "Output": "{% $states.result.Payload %}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ResizeFailed"
        }
      ],
      "Next": "CheckResizeResult"
    },
    "CheckResizeResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.status = 'resized' %}",
          "Next": "ResizeSucceeded"
        }
      ],
      "Default": "ResizeFailed"
    },
    "ResizeSucceeded": {
      "Type": "Succeed"
    },
    "ResizeFailed": {
      "Type": "Fail",
      "Error": "ResizeError",
      "Cause": "Image could not be resized"
    }
  }
}